---
import { OWNER, HOURS_SHORT, SINCE_YEAR } from "../data/site";
---

<section id="about" aria-label="About">
  <div class="wrap">
    <p class="section-kicker">Who we are</p>
    <h2>Run by Anthony, backed by crews</h2>
    <div class="about-card">
      <div>
        <p>
          {OWNER} runs Jay Painters from Ulsoor, Bangalore, since {SINCE_YEAR}. He manages
          crews of painters, sends teams to sites across the city, and works alongside
          them on the job.
        </p>
        <p>
          Homes and buildings across Bangalore; Chennai, Hyderabad, and other cities on
          request. One phone number reaches the owner directly — no middlemen, no forms.
        </p>
      </div>
      <ul class="about-facts">
        <li><b>Owner</b>{OWNER}</li>
        <li><b>Base</b>Ulsoor, Bangalore</li>
        <li><b>Hours</b>{HOURS_SHORT}, 7 days</li>
        <li><b>Area</b>Bangalore + on request</li>
      </ul>
    </div>
  </div>
</section>
