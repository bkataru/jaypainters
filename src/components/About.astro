---
import { OWNER, HOURS_SHORT } from "../data/site";
---

<section id="about" aria-label="About">
  <div class="wrap">
    <h2>About</h2>
    <p>
      {OWNER} runs Jay Painters from Ulsoor, Bangalore, since 1980. He manages
