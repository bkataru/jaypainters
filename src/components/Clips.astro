---
import { CLIPS } from "../data/site";
---

<section id="clips" aria-label="Work clips">
  <div class="wrap">
    <h2>At work</h2>
    <div class="clips">
      {
        CLIPS.map((c) => (
          <figure>
            <video
              controls
              muted
              playsinline
              preload="none"
              poster={`/posters/${c.poster}`}
              src={`/video/${c.file}`}
            />
            <figcaption>{c.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
