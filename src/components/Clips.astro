---
import { CLIPS, PHONE_TEL, PHONE_DISPLAY, waLink } from "../data/site";
---

<section id="clips" aria-label="Work clips">
  <div class="wrap">
    <p class="section-kicker">On the job</p>
    <h2>At work</h2>
    <p class="section-lead">
      Short clips from our jobs: a crew painting a ceiling, and Anthony masking wood frames for
      polish work.
    </p>
    <div class="clips">
      {CLIPS.map((c) => (
        <figure>
          <video
            controls
            muted
            playsinline
            preload="none"
            poster={`/posters/${c.poster}`}
            src={`/video/${c.file}`}
          />
          <figcaption>{c.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="btn-row clips-cta">
      <a class="btn btn-call" href={PHONE_TEL}>
        Call&nbsp;{PHONE_DISPLAY}
      </a>
      <a class="btn btn-wa" href={waLink("Hi Jay Painters, I want this quality on my job.")}>
        WhatsApp for this quality
      </a>
    </div>
  </div>
</section>
