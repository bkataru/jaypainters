---
import {
  ADDRESS,
  LANDMARK,
  HOURS_SHORT,
  HOURS_NOTE,
  MAP_URL,
  JUSTDIAL_URL,
  OWNER,
  SINCE_YEAR,
  PHONE_TEL,
  PHONE_DISPLAY,
  waLink,
} from "../data/site";

const PHONE_PATH =
  "M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z";
const CHAT_PATH =
  "M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z";
const PIN_PATH =
  "M15 10.5a3 3 0 11-6 0 3 3 0 016 0zM19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z";
---

<section id="contact" class="contact-section" aria-label="Contact" tabindex="-1">
  <div class="wrap">
    <p class="section-kicker">Get in touch</p>
    <h2>Call or WhatsApp today</h2>
    <p class="section-lead">The owner picks up and follows through himself.</p>
    <div class="contact-card">
      <div class="btn-row contact-cta">
        <a class="btn btn-call" href={PHONE_TEL}>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={PHONE_PATH} />
          </svg>
          Call&nbsp;{PHONE_DISPLAY}
        </a>
        <a
          class="btn btn-wa"
          href={waLink("Hi Jay Painters, I am ready to book a site visit in ____.")}
          target="_blank"
          rel="noopener"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={CHAT_PATH} />
          </svg>
          WhatsApp us
        </a>
      </div>
      <p class="contact-owner">
        Run by {OWNER} since {SINCE_YEAR}. He manages the crews and works on site himself.
      </p>
      <p>
        <svg
          class="pin-icon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={PIN_PATH} />
        </svg>
        {ADDRESS}
      </p>
      <p>{LANDMARK}</p>
      <p>
        Open {HOURS_SHORT}, every day. {HOURS_NOTE}.
      </p>
      <p>
        <a href={MAP_URL} target="_blank" rel="noopener">
          Get directions to the shop
        </a>
        <span class="link-sep" aria-hidden="true">
          ·
        </span>
        <a href={JUSTDIAL_URL} target="_blank" rel="noopener">
          See our JustDial listing
        </a>
        <span class="link-sep" aria-hidden="true">
          ·
        </span>
        <a
          href={waLink("Hi Jay Painters, can you share references from recent jobs near ____?")}
          target="_blank"
          rel="noopener"
        >
          See references from recent jobs
        </a>
      </p>
    </div>
  </div>
</section>
