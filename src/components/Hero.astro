---
import { PHONE_TEL, PHONE_DISPLAY, HOURS_LABEL, SINCE_YEAR, waLink, yearsSince1980 } from "../data/site";

const years = yearsSince1980();
const PHONE_PATH =
  "M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z";
const CHAT_PATH =
  "M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z";
---

<section class="hero" aria-label="Introduction">
  <div class="wrap hero-grid">
    <div>
      <p class="hero-badge"><span class="dot" aria-hidden="true"></span>Ulsoor, Bangalore · Taking new work</p>
      <h1>Painters you can call today.</h1>
      <p class="hero-sub">
        Jay Painters — homes and buildings across Bangalore since {SINCE_YEAR}. One tap to call
        or WhatsApp; the owner answers and follows up himself.
      </p>
      <div class="btn-row">
        <a class="btn btn-call" href={PHONE_TEL}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={PHONE_PATH} /></svg>
          Call {PHONE_DISPLAY}
        </a>
        <a class="btn btn-wa" href={waLink("Hi Jay Painters, I need painting work.")}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={CHAT_PATH} /></svg>
          WhatsApp us
        </a>
      </div>
      <p class="small">{HOURS_LABEL}</p>
      <div class="hero-stats">
        <div class="hero-stat"><b>{years}</b><span>years since {SINCE_YEAR}</span></div>
        <div class="hero-stat"><b>5</b><span>service groups</span></div>
        <div class="hero-stat"><b>3+</b><span>cities served</span></div>
      </div>
    </div>
    <figure class="hero-photo">
      <picture>
        <source srcset="/gallery-webp/hero-finished-exterior.webp" type="image/webp" />
        <img
          src="/gallery/hero-finished-exterior.jpg"
          alt="Finished exterior, Bangalore"
          width="750"
          height="1000"
          loading="eager"
          decoding="async"
        />
      </picture>
      <figcaption>Finished exterior, Bangalore</figcaption>
    </figure>
  </div>
</section>

<section class="trust-strip" aria-label="Why choose us">
  <div class="wrap">
    <ul class="trust-list">
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
        <div><strong>Owner answers directly</strong><span>One number, no call centre</span></div>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <div><strong>Site visit, then a clear price</strong><span>Call or WhatsApp to arrange it</span></div>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
        <div><strong>Own crews, owner on site</strong><span>Since {SINCE_YEAR}, not a broker</span></div>
      </li>
    </ul>
  </div>
</section>
