---
import { GALLERY, PHONE_TEL, PHONE_DISPLAY, waLink } from "../data/site";

const shown = GALLERY.filter((g) => !g.hero);
const featured = shown.filter((g) => g.featured);
const rest = shown.filter((g) => !g.featured);
---

<section id="gallery" class="gallery-section" aria-label="Gallery">
  <div class="wrap">
    <p class="section-kicker">Proof of work</p>
    <h2>Past work</h2>
    <p class="section-lead">
      Real sites across Bangalore — finished exteriors, interiors, and crews at work. Tap a photo to
      open it full size.
    </p>
    <div class="gallery-feature">
      {featured.map((g) => (
        <figure>
          <a class="tile" href={`/gallery/${g.file}`} aria-label={`Open larger view: ${g.caption}`}>
            <picture>
              <source
                srcset={`/gallery-webp/${g.file.replace(".jpg", ".webp")}`}
                type="image/webp"
              />
              <img
                src={`/gallery/${g.file}`}
                alt={g.caption}
                width={g.width}
                height={g.height}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </a>
          <figcaption>{g.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="gallery-grid">
      {rest.map((g) => (
        <figure>
          <a class="tile" href={`/gallery/${g.file}`} aria-label={`Open larger view: ${g.caption}`}>
            <picture>
              <source
                srcset={`/gallery-webp/${g.file.replace(".jpg", ".webp")}`}
                type="image/webp"
              />
              <img
                src={`/gallery/${g.file}`}
                alt={g.caption}
                width={g.width}
                height={g.height}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </a>
          <figcaption>{g.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="btn-row gallery-cta">
      <a class="btn btn-call" href={PHONE_TEL}>
        Call&nbsp;{PHONE_DISPLAY}
      </a>
      <a
        class="btn btn-wa"
        href={waLink("Hi Jay Painters, I saw your past work and need painting.")}
      >
        WhatsApp about a job like these
      </a>
    </div>
  </div>
</section>
