---
import { GALLERY, PHONE_TEL, PHONE_DISPLAY, waLink } from "../data/site";

const shown = GALLERY.filter((g) => !g.hero);
const featured = shown.filter((g) => g.featured);
const rest = shown.filter((g) => !g.featured);

function srcset(file: string, width: number): string {
  const slug = file.replace(".jpg", "");
  return (
    `/gallery-webp/${slug}-320.webp 320w, ` +
    `/gallery-webp/${slug}-480.webp 480w, ` +
    `/gallery-webp/${slug}-720.webp 720w, ` +
    `/gallery-webp/${slug}.webp ${width}w`
  );
}
---

<section id="gallery" class="gallery-section" aria-label="Gallery" tabindex="-1">
  <div class="wrap">
    <p class="section-kicker">Proof of work</p>
    <h2>Past work</h2>
    <p class="section-lead">
      Real sites across Bangalore: finished exteriors, interiors, and painters at work.
    </p>
    <div class="gallery-feature">
      {featured.map((g) => (
        <figure>
          <a
            class="tile"
            href={`/gallery/${g.file}`}
            target="_blank"
            rel="noopener"
            aria-label={`Open the full photo: ${g.caption}`}
          >
            <picture>
              <source
                srcset={srcset(g.file, g.width)}
                sizes="(max-width: 639px) 92vw, 520px"
                type="image/webp"
              />
              <img
                src={`/gallery/${g.file}`}
                alt=""
                width={g.width}
                height={g.height}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </a>
          <figcaption>{g.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="gallery-grid">
      {rest.map((g) => (
        <figure>
          <a
            class="tile"
            href={`/gallery/${g.file}`}
            target="_blank"
            rel="noopener"
            aria-label={`Open the full photo: ${g.caption}`}
          >
            <picture>
              <source
                srcset={srcset(g.file, g.width)}
                sizes="(max-width: 479px) 92vw, (max-width: 639px) 46vw, (max-width: 999px) 30vw, 260px"
                type="image/webp"
              />
              <img
                src={`/gallery/${g.file}`}
                alt=""
                width={g.width}
                height={g.height}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </a>
          <figcaption>{g.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="cta-links">
      <a href={PHONE_TEL}>Call&nbsp;{PHONE_DISPLAY}</a>
      <a
        href={waLink("Hi Jay Painters, I saw your past work. I need painting in ____.")}
        target="_blank"
        rel="noopener"
      >
        WhatsApp about a job like these
      </a>
    </div>
  </div>
</section>
