---
import "../styles/global.css";
import { HEAD_TITLE, THEME_COLOR } from "../data/site";

interface Props {
  title?: string;
}

const { title = HEAD_TITLE } = Astro.props;
const description =
  "Jay Painters — house and building painters in Ulsoor, Bangalore since 1980. Call or WhatsApp for interior, exterior, decorative, wood polish and commercial painting.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://jaypainters.surge.sh/gallery/hero-finished-exterior.jpg"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23ea580c'/%3E%3Ctext x='32' y='44' font-family='Arial,sans-serif' font-size='36' font-weight='bold' text-anchor='middle' fill='white'%3EJ%3C/text%3E%3C/svg%3E"
    />
    <link
      rel="preload"
      href="/fonts/outfit-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot name="main" />
    </main>
    <slot name="footer" />
    <slot name="bar" />
  </body>
</html>
